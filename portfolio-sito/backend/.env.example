# Copia questo file in .env e compila con i tuoi valori reali.
# .env NON va mai versionato su Git (aggiungilo al .gitignore).

# Chiave API di Resend (https://resend.com) — piano gratuito, 3000 email/mese
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Indirizzo dove ricevere le notifiche dei messaggi dal form
NOTIFY_EMAIL=b_giova93@hotmail.com

# Mittente delle email. Finché non verifichi un dominio custom su Resend,
# usa il dominio di test: onboarding@resend.dev
FROM_EMAIL=onboarding@resend.dev

# URL del frontend deployato (per CORS). In locale non serve,
# viene già incluso automaticamente localhost:5173 e :4173
FRONTEND_URL=https://il-tuo-sito.vercel.app

# Stringa di connessione al database.
# In locale, lascia vuoto per usare SQLite automaticamente.
# In produzione (es. Render), usa una connessione PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:port/dbname
DATABASE_URL=
